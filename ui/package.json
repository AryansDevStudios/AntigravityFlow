{
  "name": "antigravity-flow",
  "productName": "AntigravityFlow",
  "version": "1.0.0",
  "description": "Smart Voice Dictation & Multimodal AI Assistant for Google Antigravity",
  "author": "AryansDevStudios",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AryansDevStudios/AntigravityFlow.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.antigravityflow.app",
    "productName": "AntigravityFlow",
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AntigravityFlow"
    },
    "extraResources": [
      {
        "from": "../dist/AntigravityFlowDaemon.exe",
        "to": "bin/AntigravityFlowDaemon.exe"
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "marked": "^18.2.1"
  }
}
